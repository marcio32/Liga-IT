@model RefereeViewModel
@{
    ViewData["Title"] = "Crear Árbitro";
}

<link rel="stylesheet" href="~/css/player.css">

<div class="form-container">
    <div class="form-card">
        <div class="form-header">
            <i class="fas fa-whistle"></i>
            <h1>Nuevo Árbitro</h1>
            <p>Registra un nuevo árbitro en la liga</p>
        </div>

        <form asp-action="Create" method="post" class="player-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="FirstName">
                        <i class="fas fa-user"></i> Nombre
                    </label>
                    <input asp-for="FirstName" class="form-control" placeholder="Nombre del árbitro" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName">
                        <i class="fas fa-user"></i> Apellido
                    </label>
                    <input asp-for="LastName" class="form-control" placeholder="Apellido del árbitro" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="LicenseNumber">
                        <i class="fas fa-certificate"></i> Número de Licencia
                    </label>
                    <input asp-for="LicenseNumber" class="form-control" placeholder="Ej: ARB-2024-001" />
                    <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Category">
                        <i class="fas fa-star"></i> Categoría
                    </label>
                    <select asp-for="Category" class="form-control">
                        <option value="">Seleccionar categoría</option>
                        <option value="0">Nacional</option>
                        <option value="1">Regional</option>
                        <option value="2">Internacional</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input asp-for="IsActive" type="checkbox" />
                    <span>Árbitro Activo</span>
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-submit">
                    <i class="fas fa-save"></i> Guardar Árbitro
                </button>
                <a asp-action="Index" class="btn-cancel">
                    <i class="fas fa-times"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
