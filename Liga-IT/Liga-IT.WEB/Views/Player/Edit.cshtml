@model PlayerViewModel
@{
    ViewData["Title"] = "Editar Jugador";
}

<link rel="stylesheet" href="~/css/player.css">

<div class="form-container">
    <div class="form-card">
        <div class="form-header">
            <i class="fas fa-user-edit"></i>
            <h1>Editar Jugador</h1>
            <p>Actualiza la información del jugador</p>
        </div>

        <form asp-action="Edit" method="post" class="player-form">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="FirstName">
                        <i class="fas fa-user"></i> Nombre
                    </label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName">
                        <i class="fas fa-user"></i> Apellido
                    </label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Age">
                        <i class="fas fa-birthday-cake"></i> Edad
                    </label>
                    <input asp-for="Age" type="number" class="form-control" />
                    <span asp-validation-for="Age" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="JerseyNumber">
                        <i class="fas fa-hashtag"></i> Número de Camiseta
                    </label>
                    <input asp-for="JerseyNumber" type="number" class="form-control" />
                    <span asp-validation-for="JerseyNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Position">
                        <i class="fas fa-running"></i> Posición
                    </label>
                    <select asp-for="Position" class="form-control">
                        <option value="">Seleccionar posición</option>
                        <option value="Portero">Portero</option>
                        <option value="Defensa">Defensa</option>
                        <option value="Mediocampista">Mediocampista</option>
                        <option value="Delantero">Delantero</option>
                    </select>
                    <span asp-validation-for="Position" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Nationality">
                        <i class="fas fa-flag"></i> Nacionalidad
                    </label>
                    <input asp-for="Nationality" class="form-control" />
                    <span asp-validation-for="Nationality" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Height">
                        <i class="fas fa-ruler-vertical"></i> Altura (m)
                    </label>
                    <input asp-for="Height" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Height" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Weight">
                        <i class="fas fa-weight"></i> Peso (kg)
                    </label>
                    <input asp-for="Weight" type="number" step="any" class="form-control" />
                    <span asp-validation-for="Weight" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Goals">
                        <i class="fas fa-futbol"></i> Goles
                    </label>
                    <input asp-for="Goals" type="number" class="form-control" />
                    <span asp-validation-for="Goals" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Assists">
                        <i class="fas fa-hands-helping"></i> Asistencias
                    </label>
                    <input asp-for="Assists" type="number" class="form-control" />
                    <span asp-validation-for="Assists" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="YellowCards">
                        <i class="fas fa-square" style="color: #ffc107;"></i> Tarjetas Amarillas
                    </label>
                    <input asp-for="YellowCards" type="number" class="form-control" />
                    <span asp-validation-for="YellowCards" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="RedCards">
                        <i class="fas fa-square" style="color: #dc3545;"></i> Tarjetas Rojas
                    </label>
                    <input asp-for="RedCards" type="number" class="form-control" />
                    <span asp-validation-for="RedCards" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="MatchesPlayed">
                        <i class="fas fa-calendar-check"></i> Partidos Jugados
                    </label>
                    <input asp-for="MatchesPlayed" type="number" class="form-control" />
                    <span asp-validation-for="MatchesPlayed" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClubId">
                        <i class="fas fa-shield-alt"></i> Club
                    </label>
                    <select asp-for="ClubId" class="form-control">
                        <option value="">Seleccionar club</option>
                        @foreach (var club in (List<ClubViewModel>)ViewBag.Clubs)
                        {
                            <option value="@club.Id">@club.Name</option>
                        }
                    </select>
                    <span asp-validation-for="ClubId" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="DateOfBirth">
                        <i class="fas fa-calendar"></i> Fecha de Nacimiento
                    </label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="JoinedClubDate">
                        <i class="fas fa-calendar-plus"></i> Fecha de Ingreso
                    </label>
                    <input asp-for="JoinedClubDate" type="date" class="form-control" />
                    <span asp-validation-for="JoinedClubDate" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input asp-for="IsActive" type="checkbox" />
                    <span>Jugador Activo</span>
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-submit">
                    <i class="fas fa-save"></i> Actualizar Jugador
                </button>
                <a asp-action="Index" class="btn-cancel">
                    <i class="fas fa-times"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
