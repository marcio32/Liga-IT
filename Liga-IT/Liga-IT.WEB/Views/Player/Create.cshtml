@model PlayerViewModel
@{
    ViewData["Title"] = "Crear Jugador";
}

<link rel="stylesheet" href="~/css/player.css">

<div class="form-container">
    <div class="form-card">
        <div class="form-header">
            <i class="fas fa-user-plus"></i>
            <h1>Nuevo Jugador</h1>
            <p>Registra un nuevo jugador en la liga</p>
        </div>

        <form asp-action="Create" method="post" class="player-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="FirstName">
                        <i class="fas fa-user"></i> Nombre
                    </label>
                    <input asp-for="FirstName" class="form-control" placeholder="Nombre del jugador" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName">
                        <i class="fas fa-user"></i> Apellido
                    </label>
                    <input asp-for="LastName" class="form-control" placeholder="Apellido del jugador" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Age">
                        <i class="fas fa-birthday-cake"></i> Edad
                    </label>
                    <input asp-for="Age" type="number" class="form-control" />
                    <span asp-validation-for="Age" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="JerseyNumber">
                        <i class="fas fa-hashtag"></i> Número de Camiseta
                    </label>
                    <input asp-for="JerseyNumber" type="number" class="form-control" />
                    <span asp-validation-for="JerseyNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Position">
                        <i class="fas fa-running"></i> Posición
                    </label>
                    <select asp-for="Position" class="form-control">
                        <option value="">Seleccionar posición</option>
                        <option value="Portero">Portero</option>
                        <option value="Defensa">Defensa</option>
                        <option value="Mediocampista">Mediocampista</option>
                        <option value="Delantero">Delantero</option>
                    </select>
                    <span asp-validation-for="Position" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Nationality">
                        <i class="fas fa-flag"></i> Nacionalidad
                    </label>
                    <input asp-for="Nationality" class="form-control" placeholder="País de origen" />
                    <span asp-validation-for="Nationality" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Height">
                        <i class="fas fa-ruler-vertical"></i> Altura (m)
                    </label>
                    <input asp-for="Height" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Height" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Weight">
                        <i class="fas fa-weight"></i> Peso (kg)
                    </label>
                    <input asp-for="Weight" type="number" step="any" class="form-control" />
                    <span asp-validation-for="Weight" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="DateOfBirth">
                        <i class="fas fa-calendar"></i> Fecha de Nacimiento
                    </label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="JoinedClubDate">
                        <i class="fas fa-calendar-plus"></i> Fecha de Ingreso
                    </label>
                    <input asp-for="JoinedClubDate" type="date" class="form-control" />
                    <span asp-validation-for="JoinedClubDate" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ClubId">
                    <i class="fas fa-shield-alt"></i> Club
                </label>
                <select asp-for="ClubId" class="form-control">
                    <option value="">Seleccionar club</option>
                    @foreach (var club in (List<ClubViewModel>)ViewBag.Clubs)
                    {
                        <option value="@club.Id">@club.Name</option>
                    }
                </select>
                <span asp-validation-for="ClubId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input asp-for="IsActive" type="checkbox" />
                    <span>Jugador Activo</span>
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-submit">
                    <i class="fas fa-save"></i> Guardar Jugador
                </button>
                <a asp-action="Index" class="btn-cancel">
                    <i class="fas fa-times"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
