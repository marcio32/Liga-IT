@model List<PlayerViewModel>
@{
    ViewData["Title"] = "Gestión de Jugadores";
}

<link rel="stylesheet" href="~/css/player.css">

@Html.AntiForgeryToken()

<div class="player-container">
    <div class="player-header">
        <div class="header-content">
            <i class="fas fa-users"></i>
            <div>
                <h1>Gestión de Jugadores</h1>
                <p>Administra los jugadores de la liga</p>
            </div>
        </div>
        <a asp-action="Create" class="btn-add">
            <i class="fas fa-plus"></i> Nuevo Jugador
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="players-grid">
            @foreach (var player in Model)
            {
                <div class="player-card">
                    <div class="player-card-header">
                        <div class="jersey-number">@player.JerseyNumber</div>
                        <span class="badge @(player.IsActive ? "badge-active" : "badge-inactive")">
                            @(player.IsActive ? "Activo" : "Inactivo")
                        </span>
                    </div>
                    <div class="player-card-body">
                        <h3>@player.FirstName @player.LastName</h3>
                        <div class="player-info">
                            <span><i class="fas fa-running"></i> @player.Position</span>
                            <span><i class="fas fa-flag"></i> @player.Nationality</span>
                            <span><i class="fas fa-birthday-cake"></i> @player.Age años</span>
                        </div>
                        <div class="player-stats">
                            <div class="stat">
                                <i class="fas fa-futbol"></i>
                                <span>@player.Goals</span>
                            </div>
                            <div class="stat">
                                <i class="fas fa-hands-helping"></i>
                                <span>@player.Assists</span>
                            </div>
                            <div class="stat">
                                <i class="fas fa-square" style="color: #ffc107;"></i>
                                <span>@player.YellowCards</span>
                            </div>
                            <div class="stat">
                                <i class="fas fa-square" style="color: #dc3545;"></i>
                                <span>@player.RedCards</span>
                            </div>
                        </div>
                    </div>
                    <div class="player-card-footer">
                        <a asp-action="Edit" asp-route-id="@player.Id" class="btn-edit">
                            <i class="fas fa-edit"></i> Editar
                        </a>
                        <button type="button" class="btn-delete" onclick="confirmDelete(@player.Id, '@player.FirstName @player.LastName')">
                            <i class="fas fa-trash"></i> Eliminar
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-user-slash"></i>
            <h3>No hay jugadores registrados</h3>
            <p>Comienza agregando tu primer jugador</p>
            <a asp-action="Create" class="btn-add">
                <i class="fas fa-plus"></i> Crear Jugador
            </a>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            toast.success('@TempData["SuccessMessage"]');
            </text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            toast.error('@TempData["ErrorMessage"]');
            </text>
        }

        function confirmDelete(playerId, playerName) {
            Swal.fire({
                title: '¿Eliminar jugador?',
                html: `¿Estás seguro de eliminar a <strong>${playerName}</strong>?<br>Esta acción no se puede deshacer.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/Player/Delete/' + playerId;
                    
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token;
                    
                    form.appendChild(tokenInput);
                    document.body.appendChild(form);
                    form.submit();
                }
            });
        }
    </script>
}
