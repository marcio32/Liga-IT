@{
    ViewData["Title"] = "Chat";
}

<link rel="stylesheet" href="~/css/chat.css">

<div class="chat-container">
    <div class="chat-header">
        <i class="fas fa-comments"></i>
        <h1>Chat Liga IT</h1>
    </div>

    <div class="chat-box" id="chatBox">
    </div>

    <div class="chat-input-container">
        <div class="input-group">
            <input type="text" id="userInput" class="form-control" placeholder="Tu nombre" maxlength="50">
            <input type="text" id="messageInput" class="form-control" placeholder="Escribe tu mensaje..." maxlength="500" disabled>
            <button id="connectButton" class="btn-connect">
                <i class="fas fa-plug"></i> Conectar
            </button>
            <button id="sendButton" class="btn-send" disabled>
                <i class="fas fa-paper-plane"></i> Enviar
            </button>
        </div>
    </div>
</div>
<script src="~/js/chat.js"></script>